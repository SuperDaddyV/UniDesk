<Window x:Class="UniDesk.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:UniDesk.Helpers"
        xmlns:models="clr-namespace:UniDesk.Models"
        xmlns:controls="clr-namespace:UniDesk.Controls"
        mc:Ignorable="d"
        Title="{Binding DisplayTitle}"
        Height="{Binding PanelHeight}" Width="{Binding PanelWidth, Mode=TwoWay}"
        MinHeight="560" MaxHeight="1040" MinWidth="320" MaxWidth="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="{Binding IsTopMost}"
        ResizeMode="NoResize"
        Loaded="MainWindow_OnLoaded"
        >

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        <helpers:TodoDueTextConverter x:Key="TodoDueTextConverter"/>
        <helpers:TodoDueIsTodayConverter x:Key="TodoDueIsTodayConverter"/>
        <helpers:ShortcutIconConverter x:Key="ShortcutIconConverter"/>
        <helpers:BundledIconPathConverter x:Key="BundledIconPathConverter"/>
        <helpers:TodoPriorityToBrushConverter x:Key="TodoPriorityBrush"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <helpers:ScaledFontSizeConverter x:Key="ScaledFontSizeConverter"/>
        <Style x:Key="ModuleTitleIconBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style x:Key="ModuleTitleIconFillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style x:Key="ModuleTitleIconPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent"
          MouseLeftButtonDown="WindowDragSurface_OnMouseLeftButtonDown">
        <Border x:Name="WindowContainer"
                Style="{StaticResource GlassWindowBorderStyle}"
                ClipToBounds="True"
                Opacity="{Binding WindowOpacity}"
                SizeChanged="WindowContainer_OnSizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="18,5,16,3"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="{Binding DisplayTitle}"
                                   FontSize="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=18}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource HeaderIconButtonStyle}"
                                    Width="24"
                                    Height="24"
                                    Command="{Binding ToggleTopMostCommand}"
                                    ToolTip="{DynamicResource Header.TopMost}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE718;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTopMost}" Value="True">
                                                    <Setter Property="Text" Value="&#xE840;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource HeaderIconButtonStyle}"
                                    Width="24"
                                    Height="24"
                                    Command="{Binding ToggleWindowLockCommand}"
                                    ToolTip="{Binding WindowLockToolTip}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE1F6;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWindowLocked}" Value="False">
                                                    <Setter Property="Text" Value="&#xE1F7;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource HeaderIconButtonStyle}"
                                    Width="24"
                                    Height="24"
                                    Click="SettingsButton_OnClick"
                                    ToolTip="{DynamicResource Common.Settings}">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource HeaderIconButtonStyle}"
                                    Width="24"
                                    Height="24"
                                    Click="MinimizeButton_OnClick"
                                    ToolTip="{DynamicResource Header.MinimizeToTray}">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource HeaderIconButtonStyle}"
                                    Width="24"
                                    Height="24"
                                    Command="{Binding TogglePanelCollapseCommand}"
                                    ToolTip="{Binding PanelCollapseToolTip}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE70D;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                    <Setter Property="Text" Value="&#xE70E;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MainModulesScrollViewer"
                              Grid.Row="1"
                              Margin="12,0,12,10"
                              ClipToBounds="True"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="None"
                              MouseWheel="OnScrollViewerPreviewMouseWheel">
                    <Grid x:Name="MainModulesGrid"
                          ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="TimeWeatherModule"
                                Grid.Row="0"
                                Margin="0,0,0,6"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ModuleCardStyle}">
                                    <Setter Property="Padding" Value="14,10"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition>
                                        <ColumnDefinition.Style>
                                            <Style TargetType="ColumnDefinition">
                                                <Setter Property="Width" Value="142"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                        <Setter Property="Width" Value="150"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ColumnDefinition.Style>
                                    </ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="ClockHotspot"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        Padding="0,2"
                                        MouseLeftButtonDown="ClockHotspot_OnMouseLeftButtonDown">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ClockTimeText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=43}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                            <Setter Property="FontSize" Value="30"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ClockDateText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                    <Setter Property="FontSize" Value="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                            <Setter Property="FontSize" Value="10"/>
                                                            <Setter Property="Margin" Value="0,1,0,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ClockLunarText}"
                                                   Visibility="{Binding ClockLunarText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                    <Setter Property="FontSize" Value="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                                    <Setter Property="Margin" Value="0,5,0,0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                            <Setter Property="FontSize" Value="9"/>
                                                            <Setter Property="Margin" Value="0,2,0,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Column="1"
                                      Grid.Row="0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,0"
                                      ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="4,0,2,0"
                                              Visibility="{Binding HasWeatherData, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Width" Value="48"/>
                                                    <Setter Property="Height" Value="48"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                            <Setter Property="Width" Value="32"/>
                                                            <Setter Property="Height" Value="32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Image Source="{Binding WeatherIconImage}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding UseWeatherIconImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Width" Value="48"/>
                                                        <Setter Property="Height" Value="48"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                                <Setter Property="Width" Value="32"/>
                                                                <Setter Property="Height" Value="32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding WeatherIconGlyph}"
                                                       FontFamily="{StaticResource QWeatherIconsFont}"
                                                       Foreground="{Binding WeatherIconForeground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding UseWeatherIconImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="42"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                                <Setter Property="FontSize" Value="28"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WeatherTemperature}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=24}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                                <Setter Property="FontSize" Value="18"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding WeatherDescription}"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                        <Setter Property="FontSize" Value="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=12}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding WeatherDetailLine}"
                                               HorizontalAlignment="Right"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                <Setter Property="FontSize" Value="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                                <Setter Property="Margin" Value="0,6,0,0"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,6,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                        <Setter Property="Margin" Value="0,3,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE707;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding WeatherCity}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                    <Setter Property="FontSize" Value="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                                    <Setter Property="MaxWidth" Value="70"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                            <Setter Property="FontSize" Value="9"/>
                                                            <Setter Property="MaxWidth" Value="52"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=" | "
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   FontSize="11"
                                                   Margin="7,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding WeatherRangeLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding WeatherRangeLine}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Visibility="{Binding WeatherRangeLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                    <Setter Property="FontSize" Value="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPanelCollapsed}" Value="True">
                                                            <Setter Property="FontSize" Value="9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,8,0,0"
                                        Padding="8,5"
                                        CornerRadius="8"
                                        Background="#12FFFFFF">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPanelCollapsed}" Value="True"/>
                                                        <Condition Binding="{Binding Todos.HasCollapsedPanelTodo}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="7"
                                                 Height="7"
                                                 Fill="{Binding Todos.CollapsedPanelTodo.Priority, Converter={StaticResource TodoPriorityBrush}}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,7,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Todos.CollapsedPanelTodo.Title}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Todos.CollapsedPanelTodoDueText}"
                                                   FontSize="10"
                                                   Foreground="#5DB7FF"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Visibility="{Binding Todos.CollapsedPanelTodoDueText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <Popup PlacementTarget="{Binding ElementName=WindowContainer}"
                                       Placement="Left"
                                       AllowsTransparency="True"
                                       StaysOpen="True"
                                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                       IsOpen="{Binding IsCalendarPopupOpen, Mode=TwoWay}"
                                       HorizontalOffset="-8"
                                       VerticalOffset="62">
                                    <Border Width="360"
                                            Padding="16"
                                            CornerRadius="10"
                                            Background="#E6FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding CalendarMonthTitle}"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1E293B"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource HeaderIconButtonStyle}"
                                                            Width="32" Height="30"
                                                            Click="PreviousCalendarMonthButton_OnClick"
                                                            ToolTip="{DynamicResource Common.PreviousMonth}">
                                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#64748B"/>
                                                    </Button>
                                                    <Button Style="{StaticResource HeaderIconButtonStyle}"
                                                            Width="32" Height="30"
                                                            Click="NextCalendarMonthButton_OnClick"
                                                            ToolTip="{DynamicResource Common.NextMonth}">
                                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#64748B"/>
                                                    </Button>
                                                    <Button Style="{StaticResource HeaderIconButtonStyle}"
                                                            Width="32" Height="30"
                                                            Margin="4,0,0,0"
                                                            Click="CloseCalendarButton_OnClick"
                                                            ToolTip="{DynamicResource Common.Close}">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#64748B"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding CalendarSelectedDetailText}"
                                                       FontSize="13"
                                                       Foreground="#64748B"
                                                       Margin="0,0,0,14"
                                                       TextWrapping="Wrap"/>

                                            <ItemsControl Grid.Row="2"
                                                          ItemsSource="{Binding CalendarWeekdayLabels}"
                                                          Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="7"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="#64748B"
                                                                   FontSize="13"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl Grid.Row="3" ItemsSource="{Binding CalendarDays}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="7"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="43"
                                                                Height="48"
                                                                Margin="1"
                                                                Padding="0"
                                                                Click="CalendarDayButton_OnClick">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Foreground" Value="#1E293B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                            <Setter Property="Opacity" Value="0.38"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="DayBackground"
                                                                            Background="Transparent"
                                                                            CornerRadius="18">
                                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Day}"
                                                                                       FontSize="16"
                                                                                       Foreground="{TemplateBinding Foreground}"
                                                                                       HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding LunarText}"
                                                                                       FontSize="11"
                                                                                       Foreground="#64748B"
                                                                                       HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="DayBackground" Property="Background" Value="#1A3B82F6"/>
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                            <Setter TargetName="DayBackground" Property="BorderBrush" Value="#3B82F6"/>
                                                                            <Setter TargetName="DayBackground" Property="BorderThickness" Value="1"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter TargetName="DayBackground" Property="Background" Value="#1A3B82F6"/>
                                                                            <Setter TargetName="DayBackground" Property="BorderBrush" Value="#3B82F6"/>
                                                                            <Setter TargetName="DayBackground" Property="BorderThickness" Value="1"/>
                                                                            <Setter Property="Foreground" Value="#1E293B"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <controls:HardwareMonitorModuleView x:Name="HardwareMonitorModule"
                                                            Grid.Row="1"
                                                            DataContext="{Binding HardwareMonitor}"/>

                        <controls:ShortcutsModuleView x:Name="ShortcutsModule"
                                                       Grid.Row="2"
                                                       DataContext="{Binding Shortcuts}"/>

                        <controls:TodosModuleView x:Name="TodosModule"
                                                  Grid.Row="3"
                                                  DataContext="{Binding Todos}"/>

                        <controls:QuickNotesModuleView x:Name="QuickNotesModule"
                                                       Grid.Row="4"
                                                       DataContext="{Binding QuickNotes}"/>

                        <controls:QuickTextModuleView x:Name="QuickTextModule"
                                                      Grid.Row="5"
                                                      DataContext="{Binding QuickText}"/>

                        <TextBlock x:Name="EmptyModulesMessage"
                                   Grid.RowSpan="6"
                                   Text="{DynamicResource Module.NoEnabled}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{Binding FontScale, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=12}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="20"
                                   Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
