<UserControl x:Class="UniDesk.Controls.QuickNotesModuleView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="QuickNotesModule"
            Style="{StaticResource ModuleCardStyle}"
            Margin="0"
            Padding="14,12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Style="{StaticResource ModuleHeaderRowStyle}">
                    <Viewbox Style="{StaticResource ModuleHeaderIconContainerStyle}">
                        <Canvas Width="20" Height="20">
                            <Path Data="M4,3.5 L16,3.5 Q17,3.5 17,4.5 L17,15.5 Q17,16.5 16,16.5 L4,16.5 Q3,16.5 3,15.5 L3,4.5 Q3,3.5 4,3.5 Z"
                                  Style="{StaticResource ModuleTitleIconPathStyle}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"/>
                            <Path Data="M6,7 L14,7 M6,10 L14,10 M6,13 L11,13"
                                  Style="{StaticResource ModuleTitleIconPathStyle}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource Module.QuickNotes}"
                               Style="{StaticResource ModuleHeaderTextStyle}"/>
                </StackPanel>
                <Button Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Right"
                        Content="{DynamicResource QuickNote.NewButton}"
                        FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                        Padding="6,0"
                        Command="{Binding NewQuickNoteCommand}"/>
            </Grid>
    
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="None"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ScrollViewer_OnPreviewMouseLeftButtonDown"
                          PreviewMouseMove="ScrollViewer_OnPreviewMouseMove"
                          PreviewMouseLeftButtonUp="ScrollViewer_OnPreviewMouseLeftButtonUp"
                          MouseLeave="ScrollViewer_OnMouseLeave">
                <ItemsControl ItemsSource="{Binding QuickNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource GlassHighlightBrush}"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Margin="0,0,0,6"
                                    Cursor="Hand"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.EditQuickNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{DynamicResource Common.Edit}"
                                                  Command="{Binding PlacementTarget.Tag.EditQuickNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{DynamicResource QuickNote.CopyContent}"
                                                  Command="{Binding PlacementTarget.Tag.CopyQuickNoteContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.ToggleQuickNotePinnedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="{DynamicResource Common.Pin}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Header" Value="{DynamicResource Common.Unpin}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Common.Delete}"
                                                  Command="{Binding PlacementTarget.Tag.DeleteQuickNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="&#xE840;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       Margin="0,0,5,0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UpdatedAtText}"
                                                   FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=9}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Summary}"
                                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
    
            <TextBlock Grid.Row="1"
                       Text="{DynamicResource QuickNote.Empty}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="24,8"
                       IsHitTestVisible="False"
                       Visibility="{Binding HasQuickNotes, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        </Grid>
    </Border>
</UserControl>
