<UserControl x:Class="UniDesk.Controls.QuickTextModuleView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="QuickTextModule"
            Style="{StaticResource ModuleCardStyle}"
            Margin="0"
            Padding="14,12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,6,0">
                        <Canvas Width="20" Height="20">
                            <Path Data="M5,4 L15,4 L15,16 L5,16 Z M7,7 L13,7 M7,10 L13,10 M7,13 L11,13"
                                  Style="{StaticResource ModuleTitleIconPathStyle}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource Module.QuickText}"
                               Style="{StaticResource ModuleHeaderTextStyle}"
                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=13}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Content="+"
                        FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=14}"
                        Padding="7,0"
                        Command="{Binding NewTextSnippetCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuickTextSnippetsSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
    
            <Grid Grid.Row="1" Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Height="24"
                        Margin="0,0,4,0"
                        Command="{Binding SelectQuickTextModeCommand}"
                        CommandParameter="History"
                        Content="{DynamicResource QuickText.History}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuickTextHistorySelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="1"
                        Height="24"
                        Margin="4,0,0,0"
                        Command="{Binding SelectQuickTextModeCommand}"
                        CommandParameter="Snippets"
                        Content="{DynamicResource QuickText.Snippets}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuickTextSnippetsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
    
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="None"
                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel"
                              PreviewMouseLeftButtonDown="ScrollViewer_OnPreviewMouseLeftButtonDown"
                              PreviewMouseMove="ScrollViewer_OnPreviewMouseMove"
                              PreviewMouseLeftButtonUp="ScrollViewer_OnPreviewMouseLeftButtonUp"
                              MouseLeave="ScrollViewer_OnMouseLeave"
                              Visibility="{Binding IsQuickTextHistorySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding ClipboardHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource GlassHighlightBrush}"
                                        CornerRadius="8"
                                        Padding="8,6"
                                        Margin="0,0,0,6"
                                        Cursor="Hand"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.CopyClipboardHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{DynamicResource Common.Copy}"
                                                      Command="{Binding PlacementTarget.Tag.CopyClipboardHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="{DynamicResource QuickText.FavoriteAsSnippet}"
                                                      Command="{Binding PlacementTarget.Tag.FavoriteClipboardHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="{DynamicResource Common.Delete}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteClipboardHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
    
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="None"
                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel"
                              PreviewMouseLeftButtonDown="ScrollViewer_OnPreviewMouseLeftButtonDown"
                              PreviewMouseMove="ScrollViewer_OnPreviewMouseMove"
                              PreviewMouseLeftButtonUp="ScrollViewer_OnPreviewMouseLeftButtonUp"
                              MouseLeave="ScrollViewer_OnMouseLeave"
                              Visibility="{Binding IsQuickTextSnippetsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding TextSnippets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource GlassHighlightBrush}"
                                        CornerRadius="8"
                                        Padding="8,6"
                                        Margin="0,0,0,6"
                                        Cursor="Hand"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.CopyTextSnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{DynamicResource Common.Copy}"
                                                      Command="{Binding PlacementTarget.Tag.CopyTextSnippetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="{DynamicResource Common.Edit}"
                                                      Command="{Binding PlacementTarget.Tag.EditTextSnippetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="{DynamicResource Common.Delete}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteTextSnippetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE840;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       Margin="0,0,5,0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Summary}"
                                                   FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=9}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
    
                <TextBlock Text="{DynamicResource QuickText.EmptyHistory}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                           TextAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsQuickTextHistorySelected}" Value="True"/>
                                        <Condition Binding="{Binding HasClipboardHistory}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{DynamicResource QuickText.EmptySnippets}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsQuickTextSnippetsSelected}" Value="True"/>
                                        <Condition Binding="{Binding HasTextSnippets}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
    
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Button Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Left"
                        Content="{DynamicResource Common.Clear}"
                        FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                        Command="{Binding ClearClipboardHistoryCommand}"
                        Visibility="{Binding IsQuickTextHistorySelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Right"
                        Content="{DynamicResource Common.Manage}"
                        FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                        Command="{Binding OpenQuickTextManagerCommand}"
                        Visibility="{Binding IsQuickTextSnippetsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Right"
                        Content="{DynamicResource Common.Manage}"
                        FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                        Command="{Binding OpenQuickTextManagerCommand}"
                        Visibility="{Binding IsQuickTextHistorySelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
