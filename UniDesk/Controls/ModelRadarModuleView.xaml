<UserControl x:Class="UniDesk.Controls.ModelRadarModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UniDesk.Helpers"
             xmlns:models="clr-namespace:UniDesk.Models">
    <Border x:Name="ModelRadarModule"
            Style="{StaticResource ModuleCardStyle}"
            Margin="0"
            Padding="14,12"
            ClipToBounds="True">
        <StackPanel>
            <Grid Margin="0,0,0,8" Style="{StaticResource ModuleHeaderRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Style="{StaticResource ModuleHeaderIconContainerStyle}">
                    <Canvas Width="20" Height="20">
                        <Path Data="M10,2 L16.9,6 L16.9,14 L10,18 L3.1,14 L3.1,6 Z M10,5 L14.3,7.5 L14.3,12.5 L10,15 L5.7,12.5 L5.7,7.5 Z M10,10 L10,5 M10,10 L14.3,12.5 M10,10 L5.7,12.5"
                              Style="{StaticResource ModuleTitleIconPathStyle}"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource Module.ModelRadar}"
                           Style="{StaticResource ModuleHeaderTextStyle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Width="28"
                        Height="26"
                        Padding="0"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="{DynamicResource ModelRadar.Refresh}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
            </Grid>

            <StackPanel Visibility="{Binding HasNoSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="4,10,4,8"
                        HorizontalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="10"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button Content="{DynamicResource ModelRadar.RefreshRetry}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Visibility="{Binding HasSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border ToolTip="{Binding OverallDecision.ToolTipText}" Background="Transparent"
                        BorderBrush="{DynamicResource GlassHighlightBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,3,0,8"
                        Margin="0,0,0,6">
                    <StackPanel>
                        <Grid x:Name="OverallDecisionGrid" Visibility="{Binding HasOverallLeader, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Margin="0,3,0,0">
                            <Grid.Resources>
                                <helpers:RadarHeaderInsetConverter x:Key="RadarHeaderInset"/>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OverallBackendAlignmentGuide" Text="{DynamicResource ModelRadar.BackendCategory}"
                                       Visibility="Hidden" FontSize="9" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="OverallMaintenanceAlignmentGuide" Grid.Column="4" Text="{DynamicResource ModelRadar.MaintainabilityCategory}"
                                       Visibility="Hidden" FontSize="9" HorizontalAlignment="Center"/>
                            <Grid Grid.ColumnSpan="5">
                                <Grid.Margin>
                                    <MultiBinding Converter="{StaticResource RadarHeaderInset}">
                                        <Binding ElementName="OverallDecisionGrid" Path="ActualWidth"/>
                                        <Binding ElementName="OverallBackendAlignmentGuide" Path="ActualWidth"/>
                                        <Binding ElementName="OverallMaintenanceAlignmentGuide" Path="ActualWidth"/>
                                    </MultiBinding>
                                </Grid.Margin>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOP.1" FontSize="10" FontWeight="SemiBold" Margin="0,0,6,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OverallConfigurationLine" Grid.Column="1" Margin="0,0,4,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=12}"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center">
                                    <Run Text="{Binding OverallDecision.ModelName, Mode=OneWay}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding OverallDecision.ReasoningEffort, Mode=OneWay}" FontSize="10" FontWeight="Normal"/>
                                </TextBlock>
                                <TextBlock x:Name="OverallLeaderScore" Grid.Column="2"
                                       Text="{Binding OverallDecision.ScoreText}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=15}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="5" Margin="0,5,0,0"
                                          ItemsSource="{Binding OverallDecision.Dimensions}"
                                          ToolTip="{Binding OverallDecision.DimensionSummary}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" Columns="5"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,2" ToolTip="{Binding Label}">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTip="{Binding Label}"
                                                       FontFamily="{DynamicResource BodyFontFamily}" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Row="1" Text="{Binding ScoreText}" FontSize="10" Margin="0,3,0,0" TextAlignment="Center"
                                                       FontFamily="{DynamicResource BodyFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <TextBlock Text="{DynamicResource ModelRadar.Pending}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOverallLeader}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid x:Name="RadarCategories" Margin="0,0,0,5">
                    <Grid.Resources>
                        <DataTemplate x:Key="RadarCategoryLabelTemplate">
                            <TextBlock Text="{Binding}"
                                           FontFamily="{DynamicResource BodyFontFamily}"
                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </Grid.Resources>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            ToolTip="{DynamicResource ModelRadar.OverallScore}" Height="24" Padding="2,0"
                            Margin="0,0,2,0"
                            Content="{DynamicResource ModelRadar.OverallCategory}"
                            ContentTemplate="{StaticResource RadarCategoryLabelTemplate}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Overall}"
                            IsEnabled="{Binding IsOverallCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Overall}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1"
                            ToolTip="{DynamicResource ModelRadar.KnowledgeScore}" Height="24" Padding="2,0"
                            Margin="0,0,2,0"
                            Content="{DynamicResource ModelRadar.KnowledgeCategory}"
                            ContentTemplate="{StaticResource RadarCategoryLabelTemplate}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Knowledge}"
                            IsEnabled="{Binding IsKnowledgeCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Knowledge}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2"
                            ToolTip="{DynamicResource ModelRadar.BackendScore}" Height="24" Padding="2,0"
                            Margin="0,0,2,0"
                            Content="{DynamicResource ModelRadar.BackendCategory}"
                            ContentTemplate="{StaticResource RadarCategoryLabelTemplate}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Backend}"
                            IsEnabled="{Binding IsBackendCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Backend}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="3"
                            ToolTip="{DynamicResource ModelRadar.AestheticScore}"
                            Height="24" Padding="2,0"
                            Margin="0,0,2,0"
                            Content="{DynamicResource ModelRadar.AestheticCategory}"
                            ContentTemplate="{StaticResource RadarCategoryLabelTemplate}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Aesthetic}"
                            IsEnabled="{Binding IsAestheticCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Aesthetic}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="4"
                            ToolTip="{DynamicResource ModelRadar.FrontendScore}" Height="24" Padding="2,0"
                            Margin="0,0,2,0"
                            Content="{DynamicResource ModelRadar.FrontendCategory}"
                            ContentTemplate="{StaticResource RadarCategoryLabelTemplate}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Frontend}"
                            IsEnabled="{Binding IsFrontendCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Frontend}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="5"
                            ToolTip="{DynamicResource ModelRadar.MaintainabilityScore}"
                            Height="24" Padding="2,0"
                            Margin="0,0,2,0"
                            Content="{DynamicResource ModelRadar.MaintainabilityCategory}"
                            ContentTemplate="{StaticResource RadarCategoryLabelTemplate}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Maintainability}"
                            IsEnabled="{Binding IsMaintainabilityCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Maintainability}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

<TextBlock Text="{Binding RankingDescription}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RankingDescription}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="8.5"
                           Margin="1,0,0,5"/>

                <ItemsControl ItemsSource="{Binding VisibleRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="7"
                                    Padding="7,5"
                                    Margin="0,0,0,4"
                                    ToolTip="{Binding ToolTipText}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Position}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ModelName}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ReasoningEffort}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="9"
                                               TextAlignment="Right"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ScoreText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{DynamicResource ModelRadar.OfflineHint}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="8.5"
                           TextWrapping="Wrap"
                           Margin="0,1,0,5"
                           Visibility="{Binding IsOfflineCache, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Separator Margin="0,3,0,5" Opacity="0.25"/>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock FontSize="8.5" Margin="0,0,8,0">
                            <Hyperlink NavigateUri="https://modeldial.com/radar"
                                       RequestNavigate="LeaderboardLink_OnRequestNavigate"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextDecorations="{x:Null}">
                                <Run Text="ModelDial Radar"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="8.5" Margin="0,0,8,0">
                            <Hyperlink NavigateUri="https://modeldial.com/data-license"
                                       RequestNavigate="LicenseLink_OnRequestNavigate"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextDecorations="{x:Null}">
                                <Run Text="CC BY 4.0"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding PublishedText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="8.5"/>
                    </WrapPanel>
                    <TextBlock FontSize="8.5" Margin="0,3,0,0">
                        <Hyperlink x:Name="ViewFullRankingLink"
                                   NavigateUri="https://modeldial.com/radar"
                                   RequestNavigate="LeaderboardLink_OnRequestNavigate"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="SemiBold">
                            <Run Text="{DynamicResource ModelRadar.ViewFullRanking}"/>
                        </Hyperlink>
                    </TextBlock>
</StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
