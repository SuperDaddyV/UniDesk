<UserControl x:Class="UniDesk.Controls.ModelRadarModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UniDesk.Models">
    <Border x:Name="ModelRadarModule"
            Style="{StaticResource ModuleCardStyle}"
            Margin="0"
            Padding="14,12"
            ClipToBounds="True">
        <StackPanel>
            <Grid Margin="0,0,0,8" Style="{StaticResource ModuleHeaderRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Style="{StaticResource ModuleHeaderIconContainerStyle}">
                    <Canvas Width="20" Height="20">
                        <Path Data="M10,2 L16.9,6 L16.9,14 L10,18 L3.1,14 L3.1,6 Z M10,5 L14.3,7.5 L14.3,12.5 L10,15 L5.7,12.5 L5.7,7.5 Z M10,10 L10,5 M10,10 L14.3,12.5 M10,10 L5.7,12.5"
                              Style="{StaticResource ModuleTitleIconPathStyle}"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource Module.ModelRadar}"
                           Style="{StaticResource ModuleHeaderTextStyle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Width="28"
                        Height="26"
                        Padding="0"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="{DynamicResource ModelRadar.Refresh}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
            </Grid>

            <StackPanel Visibility="{Binding HasNoSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="4,10,4,8"
                        HorizontalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="10"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button Content="{DynamicResource ModelRadar.RefreshRetry}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Visibility="{Binding HasSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource GlassHighlightBrush}"
                        CornerRadius="8"
                        Padding="9,7"
                        Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ModelRadar.OverallBest}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <Grid Visibility="{Binding HasOverallLeader, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Margin="0,3,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OverallConfigurationLine"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding OverallDecision.ModelName}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding OverallDecision.ReasoningEffort}"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding OverallDecision.ScoreText}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding OverallDecision.DimensionSummary}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8.5"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource ModelRadar.Pending}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOverallLeader}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource GlassHighlightBrush}"
                        CornerRadius="8"
                        Padding="9,7"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ModelRadar.ValueRecommendation}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <Grid Visibility="{Binding HasValueRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Margin="0,3,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ValueConfigurationLine"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding ValueDecision.ModelName}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding ValueDecision.ReasoningEffort}"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ValueDecision.ScoreText}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding ValueDecision.DimensionSummary}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="8.5"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource ModelRadar.NoValueRecommendation}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasValueRecommendation}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Height="24"
                            Margin="0,0,3,0"
                            Content="{DynamicResource ModelRadar.OverallCategory}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Overall}"
                            IsEnabled="{Binding IsOverallCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Overall}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1"
                            Height="24"
                            Margin="1,0,2,0"
                            Content="{DynamicResource ModelRadar.BackendCategory}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Backend}"
                            IsEnabled="{Binding IsBackendCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Backend}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2"
                            Height="24"
                            Margin="2,0,1,0"
                            Content="{DynamicResource ModelRadar.FrontendCategory}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Frontend}"
                            IsEnabled="{Binding IsFrontendCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Frontend}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="3"
                            Height="24"
                            Margin="3,0,0,0"
                            Content="{DynamicResource ModelRadar.KnowledgeCategory}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="{x:Static models:ModelRadarCategory.Knowledge}"
                            IsEnabled="{Binding IsKnowledgeCategoryEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Static models:ModelRadarCategory.Knowledge}">
                                        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding RankingDescription}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="8.5"
                           Margin="1,0,0,5"/>

                <ItemsControl ItemsSource="{Binding VisibleRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource GlassHighlightBrush}"
                                    CornerRadius="7"
                                    Padding="7,5"
                                    Margin="0,0,0,4"
                                    ToolTip="{Binding ToolTipText}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Position}"
                                               Grid.RowSpan="2"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ModelName}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ReasoningEffort}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="8.5"
                                               TextAlignment="Right"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ScoreText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RankingDecisionTags"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="3"
                                               Text="{Binding DecisionTagsText}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="8"
                                               TextWrapping="Wrap"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding DecisionTagsText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{DynamicResource ModelRadar.OfflineHint}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="8.5"
                           TextWrapping="Wrap"
                           Margin="0,1,0,5"
                           Visibility="{Binding IsOfflineCache, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Separator Margin="0,3,0,5" Opacity="0.25"/>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock FontSize="8.5" Margin="0,0,8,0">
                            <Hyperlink NavigateUri="https://modeldial.com/radar"
                                       RequestNavigate="LeaderboardLink_OnRequestNavigate"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextDecorations="{x:Null}">
                                <Run Text="ModelDial Radar"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="8.5" Margin="0,0,8,0">
                            <Hyperlink NavigateUri="https://modeldial.com/data-license"
                                       RequestNavigate="LicenseLink_OnRequestNavigate"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextDecorations="{x:Null}">
                                <Run Text="CC BY 4.0"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding PublishedText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="8.5"/>
                    </WrapPanel>
                    <TextBlock FontSize="8.5" Margin="0,3,0,0">
                        <Hyperlink x:Name="ViewFullRankingLink"
                                   NavigateUri="https://modeldial.com/radar"
                                   RequestNavigate="LeaderboardLink_OnRequestNavigate"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="SemiBold">
                            <Run Text="{DynamicResource ModelRadar.ViewFullRanking}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource ModelRadar.PublicBenchmarkDisclaimer}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="8"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
