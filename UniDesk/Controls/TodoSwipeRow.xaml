<UserControl x:Class="UniDesk.Controls.TodoSwipeRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniDesk.Controls"
             ClipToBounds="True">
    <Grid x:Name="RootGrid" Height="46">
        <Border x:Name="DeleteStrip"
                HorizontalAlignment="Right"
                Width="72"
                CornerRadius="8"
                Background="#E53935"
                Visibility="Collapsed">
            <Button Content="{DynamicResource Common.Delete}"
                    Foreground="White"
                    FontSize="12"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DeleteButton_OnClick"/>
        </Border>

        <Border x:Name="SwipeSurface"
                CornerRadius="6"
                PreviewMouseLeftButtonDown="SwipeSurface_OnPreviewMouseLeftButtonDown"
                PreviewMouseMove="SwipeSurface_OnPreviewMouseMove"
                PreviewMouseLeftButtonUp="SwipeSurface_OnPreviewMouseLeftButtonUp"
                MouseLeave="SwipeSurface_OnMouseLeave">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearchHighlighted, RelativeSource={RelativeSource AncestorType=controls:TodoSwipeRow}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TranslateTransform x:Name="SwipeTransform"/>
            </Border.RenderTransform>
            <ContentPresenter x:Name="ContentHost"
                              Content="{Binding RowContent, RelativeSource={RelativeSource AncestorType=controls:TodoSwipeRow}}"/>
        </Border>
    </Grid>
</UserControl>
