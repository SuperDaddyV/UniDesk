<UserControl x:Class="UniDesk.Controls.TodosModuleView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniDesk.Controls">
    <Border x:Name="TodosModule"
            Style="{StaticResource ModuleCardStyle}"
            Margin="0"
            Padding="14,12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="19" Height="19" Margin="0,0,6,0">
                        <Canvas Width="20" Height="20">
                            <Path Data="M3,3.5 L17,3.5 L17,16.5 L3,16.5 Z"
                                  Style="{StaticResource ModuleTitleIconPathStyle}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  />
                            <Path Data="M5,7 L6.2,8.2 L8.3,6.1 M10,7.2 L15,7.2 M5,12 L6.2,13.2 L8.3,11.1 M10,12.2 L15,12.2"
                                  Style="{StaticResource ModuleTitleIconPathStyle}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource Module.Todos}" Style="{StaticResource ModuleHeaderTextStyle}" FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=13}"/>
                </StackPanel>
                <Button Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Right"
                        Content="+"
                        FontSize="16"
                        Padding="6,0"
                        Command="{Binding AddTodoCommand}"/>
            </Grid>
    
            <ScrollViewer x:Name="TodoScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="None"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ScrollViewer_OnPreviewMouseLeftButtonDown"
                          PreviewMouseMove="ScrollViewer_OnPreviewMouseMove"
                          PreviewMouseLeftButtonUp="ScrollViewer_OnPreviewMouseLeftButtonUp"
                          MouseLeave="ScrollViewer_OnMouseLeave">
                <ItemsControl ItemsSource="{Binding Todos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TodoSwipeRow Margin="0,0,0,2"
                                               DeleteCommand="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               EditCommand="{Binding DataContext.EditTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <controls:TodoSwipeRow.IsSearchHighlighted>
                                <MultiBinding Converter="{StaticResource IntEqualsConverter}">
                                    <Binding Path="Id"/>
                                    <Binding Path="DataContext.HighlightedTodoId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </MultiBinding>
                            </controls:TodoSwipeRow.IsSearchHighlighted>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="6" Height="6"
                                         Fill="{Binding Priority, Converter={StaticResource TodoPriorityBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="5,0,7,0"/>
                                <Ellipse Grid.Column="1"
                                         Tag="TodoCheck"
                                         Width="17" Height="17"
                                         Stroke="{DynamicResource PrimaryTextBrush}"
                                         StrokeThickness="2"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Cursor="Hand"
                                         MouseLeftButtonUp="TodoCheck_OnMouseLeftButtonUp">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent"/>
                                            <Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
                                            <Setter Property="StrokeThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter Property="StrokeThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Foreground" Value="#D5CCEA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Rectangle Height="2"
                                               RadiusX="1"
                                               RadiusY="1"
                                               Fill="#BFAFE0"
                                               Opacity="0.9"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"
                                           Margin="8,0,4,0">
                                    <TextBlock.Text>
                                        <Binding Path="." Converter="{StaticResource TodoDueTextConverter}"/>
                                    </TextBlock.Text>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#5DB7FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <Binding Path="." Converter="{StaticResource TodoDueIsTodayConverter}"/>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Foreground" Value="#FF7E45"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </controls:TodoSwipeRow>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
