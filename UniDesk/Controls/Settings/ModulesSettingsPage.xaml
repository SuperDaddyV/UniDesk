<UserControl x:Class="UniDesk.Controls.Settings.ModulesSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Settings.NavModules}" Style="{StaticResource GlassPageTitleStyle}"/>
        <Border Style="{StaticResource GlassSectionStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings.ModuleManagement}" Style="{StaticResource GlassSectionTitleStyle}"/>
                <ItemsControl ItemsSource="{Binding ModuleSettings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource GlassHighlightBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Margin="10,0" VerticalAlignment="Center"
                                              ToolTip="{DynamicResource Settings.ShowHide}"/>
                                    <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}" Content="↑"
                                            IsEnabled="{Binding CanMoveUp}" ToolTip="{DynamicResource Settings.MoveUp}"
                                            Command="{Binding DataContext.MoveModuleUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="4" Style="{StaticResource GhostButtonStyle}" Content="↓"
                                            IsEnabled="{Binding CanMoveDown}" ToolTip="{DynamicResource Settings.MoveDown}"
                                            Command="{Binding DataContext.MoveModuleDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
