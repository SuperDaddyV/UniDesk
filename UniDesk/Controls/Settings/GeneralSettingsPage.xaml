<UserControl x:Class="UniDesk.Controls.Settings.GeneralSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Settings.NavGeneral}" Style="{StaticResource GlassPageTitleStyle}"/>

        <Border Style="{StaticResource GlassSectionStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource GlassSectionTitleStyle}"/>
                <ItemsControl ItemsSource="{Binding LanguageOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayName}"
                                    Style="{StaticResource GlassChipButtonStyle}"
                                    Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Code}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GlassSectionStyle}">
            <Grid>
                <TextBlock Text="{DynamicResource Settings.Startup}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
                <CheckBox HorizontalAlignment="Right" IsChecked="{Binding StartupEnabled}"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource GlassSectionStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Settings.WeatherApi}" Style="{StaticResource GlassSectionTitleStyle}" Margin="0"/>
                    <Button HorizontalAlignment="Right"
                            Padding="12,5"
                            Command="{Binding ToggleWeatherApiEditCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GlassSecondaryButtonStyle}">
                                <Setter Property="Content" Value="{DynamicResource Common.Edit}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingWeatherApi}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource Common.Done}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <TextBlock Text="{DynamicResource Settings.WeatherApiHint}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API Host" Style="{StaticResource GlassSettingLabelStyle}"/>
                    <TextBox x:Name="WeatherApiHostTextBox"
                             Grid.Column="1" Style="{StaticResource GlassTextBoxStyle}"
                             Text="{Binding WeatherApiHost, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsEditingWeatherApi, Converter={StaticResource InverseBooleanConverter}}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API Key" Style="{StaticResource GlassSettingLabelStyle}"/>
                    <TextBox x:Name="WeatherApiKeyTextBox"
                             Grid.Column="1" Style="{StaticResource GlassTextBoxStyle}"
                             Text="{Binding WeatherApiKey, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsEditingWeatherApi, Converter={StaticResource InverseBooleanConverter}}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
