<UserControl x:Class="UniDesk.Controls.HardwareMonitorModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="HardwareMonitorModule"
            Style="{StaticResource ModuleCardStyle}"
            Margin="0,0,0,6"
            Padding="13,7,13,4"
            VerticalAlignment="Top"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
    
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="18" Height="18" Margin="0,0,6,0">
                    <Border CornerRadius="2.5"
                            BorderThickness="1.3"
                            Style="{StaticResource ModuleTitleIconBorderStyle}"/>
                    <Viewbox Margin="3.2">
                        <Canvas Width="18" Height="18">
                            <Path Data="M1.5,9 L5.2,9 L7.2,4.7 L10.4,13.3 L12.7,7.2 L14.2,9 L16.5,9"
                                  Style="{StaticResource ModuleTitleIconPathStyle}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
                <TextBlock Text="{DynamicResource Module.HardwareMonitor}"
                           Style="{StaticResource ModuleHeaderTextStyle}"
                           FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=12}"/>
            </StackPanel>
    
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
    
                <StackPanel Grid.Column="0"
                            MinHeight="30"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SystemCpuUsageText}"
                               ToolTip="{Binding SystemCpuUsageToolTip}"
                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=13}"
                               FontWeight="SemiBold"
                               LineHeight="16"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding SystemCpuTemperatureText}"
                               ToolTip="{Binding SystemCpuTemperatureToolTip}"
                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                               LineHeight="12"
                               Margin="0,2,0,0"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
    
                <StackPanel Grid.Column="1"
                            MinHeight="30"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SystemMemoryUsageText}"
                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=13}"
                               FontWeight="SemiBold"
                               LineHeight="16"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="MEM"
                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                               LineHeight="12"
                               Margin="0,2,0,0"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
    
                <StackPanel Grid.Column="2"
                            MinHeight="30"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SystemGpuUsageText}"
                               ToolTip="{Binding SystemGpuUsageToolTip}"
                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=13}"
                               FontWeight="SemiBold"
                               LineHeight="16"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding SystemGpuTemperatureText}"
                               ToolTip="{Binding SystemGpuTemperatureToolTip}"
                               FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                               LineHeight="12"
                               Margin="0,2,0,0"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
    
            <Border Grid.Row="2"
                    Margin="0,4,0,0"
                    Padding="0,3,0,0"
                    VerticalAlignment="Top"
                    TextOptions.TextRenderingMode="Grayscale"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource GlassHighlightBrush}">
                <Grid>
                    <Grid.IsSharedSizeScope>True</Grid.IsSharedSizeScope>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
    
                    <Grid x:Name="NetworkReceivedGroup"
                          Grid.Column="0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NetworkLabel"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NetworkValue"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Hardware.Receive}"
                                   FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                                   FontWeight="SemiBold"
                                   LineHeight="12"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="NetworkReceivedValueText"
                                   Grid.Column="1"
                                   Text="{Binding SystemNetworkReceivedText}"
                                   Width="78"
                                   TextAlignment="Center"
                                   FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10.5}"
                                   FontWeight="SemiBold"
                                   LineHeight="12"
                                   Margin="6,0,0,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>

                    <Grid x:Name="NetworkSentGroup"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NetworkLabel"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NetworkValue"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Hardware.Send}"
                                   FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10}"
                                   FontWeight="SemiBold"
                                   LineHeight="12"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="NetworkSentValueText"
                                   Grid.Column="1"
                                   Text="{Binding SystemNetworkSentText}"
                                   Width="78"
                                   TextAlignment="Center"
                                   FontSize="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=10.5}"
                                   FontWeight="SemiBold"
                                   LineHeight="12"
                                   Margin="6,0,0,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
