<UserControl x:Class="UniDesk.Controls.TimeWeatherModuleView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UniDesk.Models">
    <Border x:Name="TimeWeatherModule"
            ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ModuleCardStyle}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="14,10"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Height" Value="156"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Width" Value="5*"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Width" Value="56"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="142"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Width" Value="5*"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>
    
            <Border x:Name="ClockHotspot"
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Cursor="Hand"
                    Padding="0,2"
                    MouseLeftButtonDown="ClockHotspot_OnMouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="{Binding ClockTimeText}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=43}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="30"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ClockDateText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Margin" Value="0,1,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ClockLunarText}"
                               Visibility="{Binding ClockLunarText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                <Setter Property="Margin" Value="0,5,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="9"/>
                                        <Setter Property="Margin" Value="0,2,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border x:Name="CompactHardwareSummary"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="52"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Resources>
                    <Style x:Key="CompactHardwareLabelStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="8"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="CompactHardwareValueStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="9"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="3,0,0,0"/>
                        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                    </Style>
                </Border.Resources>
                <Grid Width="52" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Style="{StaticResource CompactHardwareLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding DataContext.HardwareMonitor.SystemCpuUsageText, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DataContext.HardwareMonitor.SystemCpuUsageToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CompactHardwareValueStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEM" Style="{StaticResource CompactHardwareLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding DataContext.HardwareMonitor.SystemMemoryUsageText, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CompactHardwareValueStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU" Style="{StaticResource CompactHardwareLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding DataContext.HardwareMonitor.SystemCpuTemperatureValueText, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DataContext.HardwareMonitor.SystemCpuTemperatureToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CompactHardwareValueStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="GPU" Style="{StaticResource CompactHardwareLabelStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding DataContext.HardwareMonitor.SystemGpuTemperatureValueText, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DataContext.HardwareMonitor.SystemGpuTemperatureToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CompactHardwareValueStyle}"/>
                </Grid>
            </Border>
    
            <Grid x:Name="WeatherSummary"
                  Grid.Column="2"
                  Grid.Row="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Margin" Value="6,0,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
    
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="4,0,2,0"
                          Visibility="{Binding HasWeatherData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Width" Value="48"/>
                                <Setter Property="Height" Value="48"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Width" Value="32"/>
                                        <Setter Property="Height" Value="32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Image Source="{Binding WeatherIconImage}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding UseWeatherIconImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Width" Value="48"/>
                                    <Setter Property="Height" Value="48"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Width" Value="32"/>
                                            <Setter Property="Height" Value="32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding WeatherIconGlyph}"
                                   FontFamily="{StaticResource QWeatherIconsFont}"
                                   Foreground="{Binding WeatherIconForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding UseWeatherIconImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="42"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="FontSize" Value="28"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WeatherTemperature}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=24}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="FontSize" Value="18"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding WeatherDescription}"
                                   HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                    <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=12}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="FontSize" Value="10"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
    
                <TextBlock Grid.Row="1"
                           Text="{Binding WeatherDetailLine}"
                           HorizontalAlignment="Right"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                            <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                            <Setter Property="Margin" Value="0,6,0,0"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
    
                <Grid x:Name="WeatherLocationStrip"
                      Grid.Row="2"
                      Margin="0,6,0,0"
                      ClipToBounds="True">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Margin" Value="0,3,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding WeatherCity}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Text=" | "
                               Style="{StaticResource SecondaryTextStyle}"
                               FontSize="11"
                               Margin="4,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding WeatherRangeLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding WeatherRangeLine}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Visibility="{Binding WeatherRangeLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="3"
                           HorizontalAlignment="Stretch"
                           Margin="0,2,0,0"
                           FontSize="8"
                           TextAlignment="Right"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    <Hyperlink x:Name="QWeatherAttributionLink"
                               NavigateUri="https://www.qweather.com"
                               RequestNavigate="QWeatherAttributionLink_OnRequestNavigate"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextDecorations="{x:Null}">
                        <Run Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="8"/>
                        <Run Text=" "/>
                        <Run Text="{DynamicResource Weather.QWeatherAttribution}"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
    
            <Border x:Name="CompactStatusStrip"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,4,0,0"
                    Padding="8,2"
                    CornerRadius="8"
                    Background="{DynamicResource CardSurfaceBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Resources>
                    <Style x:Key="CompactBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="LineHeight" Value="16"/>
                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="TextWrapping" Value="NoWrap"/>
                        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                    </Style>
                    <Style x:Key="CompactStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="LineHeight" Value="16"/>
                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="TextWrapping" Value="NoWrap"/>
                        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="CompactModelRadarSummary"
                          Grid.Row="0"
                          Height="32"
                          Margin="0,0,0,1"
                          ToolTip="{Binding DataContext.ModelRadar.CompactToolTipText, RelativeSource={RelativeSource AncestorType=Window}}"
                          Visibility="{Binding DataContext.ModelRadar.IsCompactSummaryVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CompactModelRadarVerticalDivider"
                                Grid.Column="1"
                                Width="1"
                                Margin="0,2"
                                Background="{DynamicResource DividerBrush}"
                                Opacity="0.45"
                                Visibility="{Binding DataContext.ModelRadar.HasCompactRecommendations, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Grid x:Name="CompactModelRadarOverallRecommendation"
                              Grid.Column="0"
                              Visibility="{Binding DataContext.ModelRadar.HasCompactRecommendations, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="16"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="CompactModelRadarOverallLabelText"
                                           FontWeight="Medium"
                                           TextTrimming="None"
                                           Style="{StaticResource CompactBodyTextStyle}"
                                           Text="{Binding DataContext.ModelRadar.CompactOverallLabelText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock x:Name="CompactModelRadarOverallScoreText"
                                           Margin="6,0,0,0"
                                           Style="{StaticResource CompactBodyTextStyle}"
                                           Text="{Binding DataContext.ModelRadar.CompactOverallScoreText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <TextBlock x:Name="CompactModelRadarOverallModelText"
                                       Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="None"
                                       Style="{StaticResource CompactBodyTextStyle}"
                                       Text="{Binding DataContext.ModelRadar.CompactOverallModelText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid>
                        <Grid x:Name="CompactModelRadarValueRecommendation"
                              Grid.Column="2"
                              Visibility="{Binding DataContext.ModelRadar.HasCompactRecommendations, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="16"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="CompactModelRadarValueLabelText"
                                           FontWeight="Medium"
                                           TextTrimming="None"
                                           Style="{StaticResource CompactBodyTextStyle}"
                                           Text="{Binding DataContext.ModelRadar.CompactValueLabelText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock x:Name="CompactModelRadarValueScoreText"
                                           Margin="6,0,0,0"
                                           Style="{StaticResource CompactBodyTextStyle}"
                                           Text="{Binding DataContext.ModelRadar.CompactValueScoreText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <TextBlock x:Name="CompactModelRadarValueModelText"
                                       Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="None"
                                       Style="{StaticResource CompactBodyTextStyle}"
                                       Text="{Binding DataContext.ModelRadar.CompactValueModelText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid>
                        <TextBlock x:Name="CompactModelRadarStatusText"
                                   Grid.ColumnSpan="3"
                                   Style="{StaticResource CompactStatusTextStyle}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding DataContext.ModelRadar.CompactStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Visibility="{Binding DataContext.ModelRadar.HasCompactRecommendations, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>

                    <Border Grid.Row="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.ModelRadar.IsCompactSummaryVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                        <Setter Property="Padding" Value="0,1,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid x:Name="CompactTodoSummary" Height="16">
                            <Grid Height="16"
                                  Visibility="{Binding DataContext.Todos.HasCollapsedPanelTodo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="7"
                                         Height="7"
                                         Fill="{Binding DataContext.Todos.CollapsedPanelTodo.Priority, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TodoPriorityBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0"/>
                                <TextBlock x:Name="CompactTodoTitleText"
                                           Grid.Column="1"
                                           Style="{StaticResource CompactBodyTextStyle}"
                                           Text="{Binding DataContext.Todos.CollapsedPanelTodo.Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock x:Name="CompactTodoDueText"
                                           Grid.Column="2"
                                           Style="{StaticResource CompactBodyTextStyle}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="8,0,0,0"
                                           Text="{Binding DataContext.Todos.CollapsedPanelTodoDueText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding DataContext.Todos.CollapsedPanelTodoDueText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Todo.NoData}"
                                       Style="{StaticResource CompactStatusTextStyle}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Visibility="{Binding DataContext.Todos.HasCollapsedPanelTodo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
    
            <Popup PlacementTarget="{Binding ElementName=ClockHotspot}"
                   Placement="Left"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                   IsOpen="{Binding IsCalendarPopupOpen, Mode=TwoWay}"
                   HorizontalOffset="-8"
                   VerticalOffset="62">
                <Border Width="360"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource WindowSurfaceBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
    
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CalendarMonthTitle}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource HeaderIconButtonStyle}"
                                        Width="32" Height="30"
                                        Click="PreviousCalendarMonthButton_OnClick"
                                        ToolTip="{DynamicResource Common.PreviousMonth}">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Button>
                                <Button Style="{StaticResource HeaderIconButtonStyle}"
                                        Width="32" Height="30"
                                        Click="NextCalendarMonthButton_OnClick"
                                        ToolTip="{DynamicResource Common.NextMonth}">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Button>
                                <Button Style="{StaticResource HeaderIconButtonStyle}"
                                        Width="32" Height="30"
                                        Margin="4,0,0,0"
                                        Click="CloseCalendarButton_OnClick"
                                        ToolTip="{DynamicResource Common.Close}">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
    
                        <TextBlock Grid.Row="1"
                                   Text="{Binding CalendarSelectedDetailText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,0,0,14"
                                   TextWrapping="Wrap"/>
    
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding CalendarWeekdayLabels}"
                                      Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="13"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
    
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="43"
                                            Height="48"
                                            Margin="1"
                                            Padding="0"
                                            Click="CalendarDayButton_OnClick">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                        <Setter Property="Opacity" Value="0.38"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="DayBackground"
                                                        Background="Transparent"
                                                        CornerRadius="18">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Day}"
                                                                   FontSize="16"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LunarText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DayBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter TargetName="DayBackground" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="DayBackground" Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="DayBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                        <Setter TargetName="DayBackground" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="DayBackground" Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
