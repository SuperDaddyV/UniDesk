<UserControl x:Class="UniDesk.Controls.TimeWeatherModuleView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UniDesk.Models">
    <Border x:Name="TimeWeatherModule"
            ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ModuleCardStyle}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Height" Value="{Binding DataContext.CompactLayout.ContentHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Height" Value="{Binding DataContext.CompactLayout.TopHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="1.15*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Width" Value="{Binding DataContext.CompactLayout.ClockColumn, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Width" Value="{Binding DataContext.CompactLayout.HardwareColumn, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Width" Value="{Binding DataContext.CompactLayout.WeatherColumn, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>
    
            <Border x:Name="ClockHotspot"
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonDown="ClockHotspot_OnMouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.CompactLayout.ShowTimeWeather, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                             VerticalAlignment="Center"
                             >
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <TextBlock Text="{Binding ClockTimeText}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=40}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="FontSize" Value="30"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="{Binding ClockShortDateText}"
                               VerticalAlignment="Top"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ClockDateText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=12}"/>
                                <Setter Property="Margin" Value="0,6,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Margin" Value="0,1,0,0"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="2" Text="{Binding ClockLunarText}"
                               VerticalAlignment="Top"
                               ToolTip="{Binding ClockLunarText}"
                               Visibility="{Binding ClockLunarText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="9"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,2,0,0"/>
                                        <Setter Property="MaxHeight" Value="13"/>
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border x:Name="CompactHardwareSummary"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="50"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.CompactLayout.ShowHardware, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Resources>
                    <Style x:Key="CompactHardwareLabelStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="8"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="CompactHardwareValueStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="9"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="3,0,0,0"/>
                        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                    </Style>
                </Border.Resources>
                <Grid Width="50" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="16"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Style="{StaticResource CompactHardwareLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding DataContext.HardwareMonitor.SystemCpuUsageText, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DataContext.HardwareMonitor.SystemCpuUsageToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CompactHardwareValueStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="MEM" Style="{StaticResource CompactHardwareLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding DataContext.HardwareMonitor.SystemMemoryUsageText, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CompactHardwareValueStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" Style="{StaticResource CompactHardwareLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding DataContext.HardwareMonitor.SystemGpuUsageText, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DataContext.HardwareMonitor.SystemGpuUsageToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CompactHardwareValueStyle}"/>
                </Grid>
            </Border>
    
            <Grid x:Name="WeatherSummary"
                  Grid.Column="2"
                  Grid.Row="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
    
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="50"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Width" Value="36"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,2,0"
                          Visibility="{Binding HasWeatherData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Width" Value="48"/>
                                <Setter Property="Height" Value="48"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Width" Value="32"/>
                                        <Setter Property="Height" Value="32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Image Source="{Binding WeatherIconImage}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding UseWeatherIconImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Width" Value="48"/>
                                    <Setter Property="Height" Value="48"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Width" Value="32"/>
                                            <Setter Property="Height" Value="32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding WeatherIconGlyph}"
                                   FontFamily="{StaticResource QWeatherIconsFont}"
                                   Foreground="{Binding WeatherIconForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding UseWeatherIconImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="42"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="FontSize" Value="28"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0"
                                 Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 HorizontalAlignment="Right">
                            <TextBlock Text="{Binding WeatherTemperature}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=24}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="FontSize" Value="18"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            </TextBlock>
                        </Viewbox>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding WeatherDescription}"
                                   TextAlignment="Right"
                                   ToolTip="{Binding WeatherDescription}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=12}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
    
                <TextBlock Grid.Row="1"
                           Text="{Binding WeatherDetailLine}"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Right"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                            <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                            <Setter Property="Margin" Value="0,4,0,0"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="ToolTip" Value="{Binding WeatherAirQualityAttributionText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WeatherAirQualityAttributionText}" Value="">
                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
    
                <Grid x:Name="WeatherLocationStrip"
                      Grid.Row="2"
                      VerticalAlignment="Top"
                      ClipToBounds="True">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Margin" Value="0,4,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Margin" Value="0,2,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding WeatherCity}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Right">
                        <TextBlock.ToolTip>
                            <MultiBinding StringFormat="{}{0}  {1}">
                                <Binding Path="WeatherCity"/>
                                <Binding Path="WeatherRangeLine"/>
                            </MultiBinding>
                        </TextBlock.ToolTip>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Text=" | "
                               FontSize="11"
                               Margin="4,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="Visibility" Value="{Binding WeatherRangeLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2"
                               Text="{Binding WeatherRangeLine}"
                               VerticalAlignment="Center"
                               TextAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="Visibility" Value="{Binding WeatherRangeLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                <Setter Property="FontSize" Value="{Binding DataContext.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledFontSizeConverter}, ConverterParameter=11}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="FontSize" Value="9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Grid x:Name="CompactWeatherSummary" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.CompactLayout.ShowTimeWeather, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding CompactWeatherLocationLine}"/>
                        <TextBlock Text="{Binding WeatherRangeLine}" Visibility="{Binding WeatherRangeLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding CompactWeatherDetailLine}" Visibility="{Binding CompactWeatherDetailLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding WeatherAirQualityAttributionText}" Visibility="{Binding WeatherAirQualityAttributionText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid.ToolTip>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid Width="32" Height="32" Margin="0,0,5,0" Visibility="{Binding HasWeatherData, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{Binding WeatherIconImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding UseWeatherIconImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding WeatherIconGlyph}" FontFamily="{StaticResource QWeatherIconsFont}" FontSize="28"
                                       Foreground="{Binding WeatherIconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding UseWeatherIconImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                        <TextBlock Text="{Binding WeatherTemperature}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CompactWeatherLocationLine}" FontSize="10" Margin="0,3,0,0" TextAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CompactWeatherDetailLine}" FontSize="9" Margin="0,4,0,0" TextAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding CompactWeatherDetailLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <Border x:Name="CompactStatusStrip" Grid.Row="1" Grid.ColumnSpan="3" Padding="8,2" CornerRadius="8"
                    Background="{DynamicResource CardSurfaceBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Margin" Value="{Binding DataContext.CompactLayout.StatusMargin, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsPanelCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.CompactLayout.HasStatus, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Resources>
                    <Style x:Key="CompactBodyTextStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="TextWrapping" Value="NoWrap"/>
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <Grid x:Name="CompactModelRadarSummary" Height="24"
                          ToolTip="{Binding DataContext.ModelRadar.CompactToolTipText, RelativeSource={RelativeSource AncestorType=Window}}"
                          Visibility="{Binding DataContext.CompactLayout.ShowModelRadar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid x:Name="CompactModelRadarOverallRecommendation"
                              HorizontalAlignment="Center"
                              Visibility="{Binding DataContext.ModelRadar.HasCompactRecommendations, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DataContext.ModelRadar.CompactOverallLabelText, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource CompactBodyTextStyle}" FontSize="9" MaxWidth="52"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding DataContext.ModelRadar.CompactOverallModelNameText, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource CompactBodyTextStyle}" FontSize="11" FontWeight="SemiBold"/>
                            <Border Grid.Column="2" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource GlassHighlightBrush}">
                                <TextBlock Text="{Binding DataContext.ModelRadar.CompactOverallEffortText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Style="{StaticResource CompactBodyTextStyle}" FontSize="9"/>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding DataContext.ModelRadar.CompactOverallScoreText, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource CompactBodyTextStyle}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding DataContext.ModelRadar.CompactStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource CompactBodyTextStyle}"
                                   Visibility="{Binding DataContext.ModelRadar.HasCompactRecommendations, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>
                    <Border x:Name="CompactTodoStrip" Height="24"
                            Visibility="{Binding DataContext.CompactLayout.ShowTodos, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CompactLayout.ShowModelRadar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid x:Name="CompactTodoSummary" ToolTip="{Binding DataContext.Todos.CollapsedPanelTodo.Title, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid Visibility="{Binding DataContext.Todos.HasCollapsedPanelTodo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{Binding DataContext.Todos.CollapsedPanelTodo.Priority, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TodoPriorityBrush}}"/>
                                <TextBlock x:Name="CompactTodoTitleText" Grid.Column="1" Style="{StaticResource CompactBodyTextStyle}"
                                           Text="{Binding DataContext.Todos.CollapsedPanelTodo.Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock x:Name="CompactTodoDueText" Grid.Column="2" Style="{StaticResource CompactBodyTextStyle}"
                                           Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0"
                                           Text="{Binding DataContext.Todos.CollapsedPanelTodoDueText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding DataContext.Todos.CollapsedPanelTodoDueText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Todo.NoData}" Style="{StaticResource CompactBodyTextStyle}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Visibility="{Binding DataContext.Todos.HasCollapsedPanelTodo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <Popup PlacementTarget="{Binding ElementName=ClockHotspot}"
                   Placement="Left"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                   IsOpen="{Binding IsCalendarPopupOpen, Mode=TwoWay}"
                   HorizontalOffset="-8"
                   VerticalOffset="62">
                <Border Width="360"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource WindowSurfaceBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
    
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CalendarMonthTitle}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource HeaderIconButtonStyle}"
                                        Width="32" Height="30"
                                        Click="PreviousCalendarMonthButton_OnClick"
                                        ToolTip="{DynamicResource Common.PreviousMonth}">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Button>
                                <Button Style="{StaticResource HeaderIconButtonStyle}"
                                        Width="32" Height="30"
                                        Click="NextCalendarMonthButton_OnClick"
                                        ToolTip="{DynamicResource Common.NextMonth}">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Button>
                                <Button Style="{StaticResource HeaderIconButtonStyle}"
                                        Width="32" Height="30"
                                        Margin="4,0,0,0"
                                        Click="CloseCalendarButton_OnClick"
                                        ToolTip="{DynamicResource Common.Close}">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
    
                        <TextBlock Grid.Row="1"
                                   Text="{Binding CalendarSelectedDetailText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,0,0,14"
                                   TextWrapping="Wrap"/>
    
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding CalendarWeekdayLabels}"
                                      Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="13"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
    
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="43"
                                            Height="48"
                                            Margin="1"
                                            Padding="0"
                                            Click="CalendarDayButton_OnClick">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                        <Setter Property="Opacity" Value="0.38"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="DayBackground"
                                                        Background="Transparent"
                                                        CornerRadius="18">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Day}"
                                                                   FontSize="16"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LunarText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DayBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter TargetName="DayBackground" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="DayBackground" Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="DayBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                        <Setter TargetName="DayBackground" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="DayBackground" Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
