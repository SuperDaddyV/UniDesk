<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default dark-following scheme: tinted glass with wallpaper-visible alpha. -->
    <Color x:Key="WindowSurfaceColor">#E52F3A47</Color>
    <Color x:Key="SettingsSurfaceColor">#D92F3A47</Color>
    <Color x:Key="SecondarySurfaceColor">#A5243038</Color>
    <Color x:Key="CardSurfaceColor">#661C2833</Color>
    <Color x:Key="CardHoverColor">#8028343F</Color>
    <Color x:Key="ControlSurfaceColor">#802C3840</Color>
    <Color x:Key="PrimaryTextColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#F0FFFFFF</Color>
    <Color x:Key="MutedTextColor">#BFFFFFFF</Color>
    <Color x:Key="AccentColor">#FF94A3B8</Color>
    <Color x:Key="AccentForegroundColor">#FF27272A</Color>
    <Color x:Key="AccentSoftColor">#3D94A3B8</Color>
    <Color x:Key="FocusRingColor">#CC94A3B8</Color>
    <Color x:Key="DividerColor">#3D64748B</Color>
    <Color x:Key="SuccessColor">#FF8BD5A1</Color>
    <Color x:Key="WarningColor">#FFF7C873</Color>
    <Color x:Key="DangerColor">#FFF38BA8</Color>
    <Color x:Key="DangerForegroundColor">#FF1E1E2E</Color>
    <Color x:Key="ErrorColor">#FFF38BA8</Color>
    <Color x:Key="NoteBackgroundColor">#FFFFF4D6</Color>
    <Color x:Key="NoteTextColor">#FF3D3D3D</Color>
    <Color x:Key="GlassHighlightColor">#26FFFFFF</Color>

    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="{StaticResource WindowSurfaceColor}"/>
    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="{StaticResource SettingsSurfaceColor}"/>
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}"/>
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="{StaticResource ControlSurfaceColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{StaticResource DangerForegroundColor}"/>

    <!-- Existing names remain aliases for controls and saved themes. -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource WindowSurfaceColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondarySurfaceColor}"/>
    <SolidColorBrush x:Key="ModuleBackgroundBrush" Color="{StaticResource CardSurfaceColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="NoteBackgroundBrush" Color="{StaticResource NoteBackgroundColor}"/>
    <SolidColorBrush x:Key="NoteTextBrush" Color="{StaticResource NoteTextColor}"/>
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="{StaticResource GlassHighlightColor}"/>

    <!-- Legacy color keys are retained for AppColorSchemeCatalog discovery. -->
    <Color x:Key="PrimaryBackgroundColor">#E52F3A47</Color>
    <Color x:Key="SecondaryBackgroundColor">#A5243038</Color>
    <Color x:Key="ModuleBackgroundColor">#661C2833</Color>

</ResourceDictionary>

