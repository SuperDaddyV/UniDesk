<Window x:Class="UniDesk.Windows.UpdateResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        MaxWidth="420"
        KeyDown="Window_OnKeyDown">

    <Border Background="#F5FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource Update.AvailableTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Update.CurrentVersionLabel}"
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="CurrentVersionText"
                           Grid.Column="1"
                           FontSize="12"
                           Foreground="#1E293B"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Update.LatestVersionLabel}"
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="LatestVersionText"
                           Grid.Column="1"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"/>
            </Grid>
            <TextBlock x:Name="PublishedAtText"
                       FontSize="11"
                       Foreground="#64748B"
                       Margin="0,0,0,10"/>
            <TextBlock Text="{DynamicResource Update.ReleaseNotesLabel}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Margin="0,0,0,6"/>
            <Border Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    MaxHeight="180"
                    Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ReleaseNotesText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#334155"/>
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Update.LaterButton}"
                        Width="92"
                        Height="32"
                        Margin="0,0,8,0"
                        FontSize="12"
                        Cursor="Hand"
                        Background="#F8FAFC"
                        Foreground="#64748B"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Click="LaterButton_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="{DynamicResource Update.OpenDownloadPageButton}"
                        MinWidth="132"
                        Height="32"
                        Padding="12,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Foreground="White"
                        Background="#3B82F6"
                        BorderThickness="0"
                        Click="OpenButton_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
