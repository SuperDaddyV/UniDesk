<Window x:Class="UniDesk.NoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="420"
        Width="360"
        MinHeight="320"
        MinWidth="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        KeyDown="NoteEditWindow_OnKeyDown">

    <Border CornerRadius="8"
            Background="{DynamicResource NoteBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,12"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Common.Source}"
                                   FontSize="15"
                                   Foreground="{DynamicResource NoteTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="18"
                                Padding="9,5">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="✦"
                                               Foreground="{DynamicResource AccentForegroundBrush}"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="UniDesk"
                                           FontSize="15"
                                            Foreground="{DynamicResource NoteTextBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="×"
                                           FontSize="18"
                                            Foreground="{DynamicResource NoteTextBrush}"
                                           Margin="10,-1,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource HeaderIconButtonStyle}"
                                Foreground="{DynamicResource NoteTextBrush}"
                                Click="MinimizeButton_OnClick"
                                ToolTip="{DynamicResource Common.Minimize}">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource HeaderIconButtonStyle}"
                                Foreground="{DynamicResource NoteTextBrush}"
                                Click="CloseButton_OnClick"
                                ToolTip="{DynamicResource Common.Close}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,10,26,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource NoteTextBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0,0,0,14"/>

                <TextBox Grid.Row="1"
                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="20"
                         Foreground="{DynamicResource NoteTextBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         CaretBrush="{DynamicResource NoteTextBrush}"/>
            </Grid>

            <Grid Grid.Row="2" Margin="22,16,22,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource HeaderIconButtonStyle}"
                            Foreground="{DynamicResource NoteTextBrush}"
                            ToolTip="{DynamicResource Common.More}">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                    <Button Style="{StaticResource HeaderIconButtonStyle}"
                            Foreground="{DynamicResource NoteTextBrush}"
                            ToolTip="{DynamicResource Common.PopOut}">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Common.Cancel}"
                            Width="72"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource NoteTextBrush}"
                            BorderThickness="0"
                            Click="CancelButton_OnClick"/>
                    <Button Content="{DynamicResource Common.Save}"
                            Width="72"
                            Height="34"
                            IsDefault="True"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            BorderThickness="0"
                            Click="SaveButton_OnClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
