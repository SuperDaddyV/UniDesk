<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\HardwareSensors\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\UniDesk\icon\Icons8\*.png">
      <Link>icon\Icons8\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\UniDesk\icon\QWeather-Icons-1.8.0\font\qweather-icons.css">
      <Link>icon\QWeather-Icons-1.8.0\font\qweather-icons.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniDesk.Hardware.Contracts\UniDesk.Hardware.Contracts.csproj" />
    <ProjectReference Include="..\UniDesk.HardwareRepair\UniDesk.HardwareRepair.csproj" />
    <ProjectReference Include="..\UniDesk.HardwareService\UniDesk.HardwareService.csproj" />
    <ProjectReference Include="..\UniDesk\UniDesk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
